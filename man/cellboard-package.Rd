\item call the QC engine programmatically (\code{\link[=compute_qc]{compute_qc()}}, \code{\link[=apply_qc_filter]{apply_qc_filter()}});
\item render a standalone report with \code{\link[=render_qc_report]{render_qc_report()}}.
}
